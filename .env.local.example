# =============================================================================
# GlowScale - variaveis de ambiente
# Copie para .env.local e preencha. NUNCA comite valores reais.
# =============================================================================

# ----------------------------------------------------------------- Supabase --
# Painel Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
# Chave publica (publishable / anon). Pode ir para o browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Compatibilidade: se o seu projeto ainda usa o nome antigo, preencha este.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SEGREDO. Somente server-side. Nunca prefixar com NEXT_PUBLIC_.
# Usada apenas pelos webhooks de pagamento e pelas escritas de assinatura.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------- Pagamento --
# Quem cobra a mensalidade: stripe | asaas
# Deixe vazio para usar automaticamente o que estiver configurado.
PAGAMENTO_PROVEDOR=stripe

# ------------------------------------------------------------------- Stripe --
# SEGREDO. Somente server-side. Nunca prefixar com NEXT_PUBLIC_.
# Painel Stripe > Developers > API keys > Secret key
# Comeca com sk_test_ em teste e sk_live_ em producao.
STRIPE_SECRET_KEY=

# Um preco recorrente mensal (price_..., NAO prod_...) por plano.
# Painel Stripe > Product catalog > seu produto > secao Pricing.
# Basta preencher os planos que voce quer vender: os demais nao aparecem.
STRIPE_PRICE_SOLO=      # Solo   - R$ 47/mes
STRIPE_PRICE_STUDIO=    # Studio - R$ 97/mes
STRIPE_PRICE_SCALE=     # Scale  - R$ 197/mes

# SEGREDO. Painel Stripe > Developers > Webhooks > seu endpoint >
# "Signing secret". Comeca com whsec_.
# Sem ele o webhook recusa todos os eventos - e a unica prova de que o
# request veio mesmo do Stripe.
STRIPE_WEBHOOK_SECRET=

# -------------------------------------------------------------------- Asaas --
# Alternativa ao Stripe. Ignorado quando PAGAMENTO_PROVEDOR=stripe.
# sandbox | production
ASAAS_ENVIRONMENT=sandbox
# SEGREDO. Somente server-side.
ASAAS_API_KEY=
# Token que o Asaas envia no header asaas-access-token do webhook.
# Configure o mesmo valor no painel do Asaas.
ASAAS_WEBHOOK_TOKEN=
# Opcional: sobrescreve a URL base derivada de ASAAS_ENVIRONMENT.
# sandbox    -> https://api-sandbox.asaas.com/v3
# production -> https://api.asaas.com/v3
ASAAS_BASE_URL=

# ------------------------------------------------------------- Login social --
# Provedores mostrados na tela de login, separados por virgula.
# Aceita: google, facebook, apple. Deixe vazio para nao mostrar nenhum.
#
# So liste um provedor DEPOIS de ativa-lo em Authentication > Sign In /
# Providers no Supabase. Um botao que devolve erro porque o provedor nao esta
# configurado custa mais confianca do que a ausencia do botao.
NEXT_PUBLIC_OAUTH_PROVIDERS=

# ------------------------------------------------------------------- Idioma --
# O idioma da interface e escolhido pela pessoa e guardado em cookie.
# Nao ha variavel para isso: pt-BR e o padrao quando nada foi escolhido.

# ---------------------------------------------------------------- Aplicacao --
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Plano padrao oferecido no checkout.
# Com o Stripe, o VALOR exibido vem do proprio Stripe (o preco de
# STRIPE_PRICE_ID) - esta constante so cobre a vitrine antes do login e
# serve de reserva se a leitura falhar.
NEXT_PUBLIC_PLANO_NOME=Essencial
NEXT_PUBLIC_PLANO_VALOR=97.00
